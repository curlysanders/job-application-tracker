{% extends 'base.html.twig' %}

{% block title %}Sign in · Job Application Tracker{% endblock %}
{% block page_heading %}Sign in{% endblock %}

{% block content %}
    <section class="panel form-panel" aria-labelledby="login-heading">
        <h2 id="login-heading">Welcome back</h2>
        {% if error %}
            <p class="form-error" role="alert">Invalid email or password.</p>
        {% endif %}
        <form method="post">
            <label for="username">Email address</label>
            <input id="username" name="_username" type="email" value="{{ lastUsername }}" autocomplete="email" required autofocus>
            <label for="password">Password</label>
            <input id="password" name="_password" type="password" autocomplete="current-password" required>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="button" type="submit">Sign in</button>
        </form>
        <p>Need an account? <a href="{{ path('app_register') }}">Register</a></p>
    </section>
{% endblock %}
