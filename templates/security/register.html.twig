{% extends 'base.html.twig' %}

{% block title %}Register · Job Application Tracker{% endblock %}
{% block page_heading %}Create your account{% endblock %}

{% block content %}
    <section class="panel form-panel" aria-labelledby="register-heading">
        <h2 id="register-heading">Start tracking your job search</h2>
        {{ form_start(registrationForm) }}
            {{ form_row(registrationForm.email) }}
            {{ form_row(registrationForm.plainPassword.first) }}
            {{ form_row(registrationForm.plainPassword.second) }}
            <p class="form-help">Use at least 12 characters, including uppercase and lowercase letters, a base-10 digit, and a symbol.</p>
            <button class="button" type="submit">Create account</button>
        {{ form_end(registrationForm) }}
        <p>Already have an account? <a href="{{ path('app_login') }}">Sign in</a></p>
    </section>
{% endblock %}
