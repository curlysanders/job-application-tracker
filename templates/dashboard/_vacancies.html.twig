{% set returnUrl = path('app_dashboard', query|merge({page: overview.page})) %}
<section class="panel dashboard-vacancy-table-panel" aria-labelledby="dashboard-vacancies-heading">
    <div class="section-heading"><div><h2 id="dashboard-vacancies-heading">Vacancies</h2><p class="section-description">Search and keep every opportunity moving.</p></div></div>
    <form method="get" action="{{ path('app_dashboard') }}" class="dashboard-vacancy-filters">
        <label class="filter-field filter-search" for="vacancy-search"><span>Search</span><input id="vacancy-search" name="q" type="search" value="{{ filter.query ?? '' }}" placeholder="Title, company, or technology"></label>
        <label class="filter-field" for="vacancy-status-filter"><span>Status</span><select id="vacancy-status-filter" name="status"><option value="">All statuses</option>{% for status in enum('CurlySanders\\JobApplicationTracker\\Domain\\Vacancy\\VacancyStatus').cases %}<option value="{{ status.value }}"{% if filter.status == status %} selected{% endif %}>{{ status.label }}</option>{% endfor %}</select></label>
        <label class="filter-field" for="vacancy-excitement-filter"><span>Excitement</span><select id="vacancy-excitement-filter" name="excitement"><option value="">All ratings</option>{% for rating in 0..5 %}<option value="{{ rating }}"{% if filter.excitement is same as(rating) %} selected{% endif %}>{{ rating }} stars</option>{% endfor %}</select></label>
        <label class="filter-field" for="vacancy-work-mode-filter"><span>Work mode</span><select id="vacancy-work-mode-filter" name="work_mode"><option value="">All work modes</option>{% for mode in enum('CurlySanders\\JobApplicationTracker\\Domain\\Vacancy\\WorkMode').cases %}<option value="{{ mode.value }}"{% if filter.workMode == mode %} selected{% endif %}>{{ mode.value|lower|capitalize }}</option>{% endfor %}</select></label>
        <label class="filter-field" for="vacancy-salary-fit-filter"><span>Salary fit</span><select id="vacancy-salary-fit-filter" name="salary_fit"><option value="">All salary fits</option>{% for fit in enum('CurlySanders\\JobApplicationTracker\\Application\\Vacancy\\Overview\\SalaryFit').cases %}<option value="{{ fit.value }}"{% if filter.salaryFit == fit %} selected{% endif %}>{{ fit.label }}</option>{% endfor %}</select></label>
        <label class="filter-field" for="vacancy-archive-filter"><span>Records</span><select id="vacancy-archive-filter" name="archived"><option value=""{% if not filter.archived %} selected{% endif %}>Active</option><option value="1"{% if filter.archived %} selected{% endif %}>Archived</option></select></label>
        <div class="filter-actions"><button class="button" type="submit">Apply filters</button><a class="button button-quiet" href="{{ path('app_dashboard') }}">Reset</a></div>
    </form>

    {% if overview.vacancies is empty %}
        <p>No vacancies match these filters.</p>
    {% else %}
        <div class="dashboard-vacancy-cards">
            {% for vacancy in overview.vacancies %}
                <article class="dashboard-vacancy-card">
                    <div class="dashboard-vacancy-card-heading">
                        <div>
                            <h3><a href="{{ path('app_vacancy_show', {id: vacancy.id}) }}">{{ vacancy.title }}</a></h3>
                            <p>{{ vacancy.companyName ?? vacancy.recruiterName ?? 'No company or recruiter' }}</p>
                        </div>
                        <span class="vacancy-status-pill">{{ vacancy.status.label }}</span>
                    </div>
                    <dl class="dashboard-vacancy-card-details">
                        <div><dt>Work mode</dt><dd>{{ vacancy.workMode ? vacancy.workMode.value|lower|capitalize : '—' }}</dd></div>
                        <div><dt>Tech stack</dt><dd>{{ vacancy.techStackNames is empty ? '—' : vacancy.techStackNames|join(', ') }}</dd></div>
                        <div><dt>Excitement</dt><dd aria-label="{{ vacancy.excitement is null ? 'No excitement rating' : vacancy.excitement ~ ' of 5 stars' }}">{% if vacancy.excitement is null %}—{% else %}{% for star in 1..5 %}{{ star <= vacancy.excitement ? '★' : '☆' }}{% endfor %}{% endif %}</dd></div>
                        <div><dt>Salary</dt><dd>{{ vacancy.salary ?? '—' }} <small>({{ vacancy.salaryFit.label }})</small></dd></div>
                        <div><dt>Next action</dt><dd>{% if vacancy.nextActionAt %}{{ vacancy.nextActionTitle ?? 'Next action' }}<br><time datetime="{{ vacancy.nextActionAt|date('c') }}">{{ vacancy.nextActionAt|date('d M Y, H:i') }}</time>{% else %}—{% endif %}</dd></div>
                    </dl>
                    {% include 'dashboard/_vacancy_actions.html.twig' with { vacancy: vacancy, returnUrl: returnUrl } only %}
                </article>
            {% endfor %}
        </div>
        <div class="dashboard-vacancy-table-wrapper">
            <table class="dashboard-vacancy-table">
                <thead><tr><th scope="col">Job title</th><th scope="col">Company / recruiter</th><th scope="col">Work mode</th><th scope="col">Tech stack</th><th scope="col">Excitement</th><th scope="col">Salary</th><th scope="col">Next action</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                    {% for vacancy in overview.vacancies %}
                        <tr>
                            <td><a href="{{ path('app_vacancy_show', {id: vacancy.id}) }}">{{ vacancy.title }}</a></td>
                            <td>{{ vacancy.companyName ?? vacancy.recruiterName ?? '—' }}</td>
                            <td>{{ vacancy.workMode ? vacancy.workMode.value|lower|capitalize : '—' }}</td>
                            <td>{{ vacancy.techStackNames is empty ? '—' : vacancy.techStackNames|join(', ') }}</td>
                            <td aria-label="{{ vacancy.excitement is null ? 'No excitement rating' : vacancy.excitement ~ ' of 5 stars' }}">{% if vacancy.excitement is null %}—{% else %}{% for star in 1..5 %}{{ star <= vacancy.excitement ? '★' : '☆' }}{% endfor %}{% endif %}</td>
                            <td>{{ vacancy.salary ?? '—' }} <small>({{ vacancy.salaryFit.label }})</small></td>
                            <td>{% if vacancy.nextActionAt %}{{ vacancy.nextActionTitle ?? 'Next action' }}<br><time datetime="{{ vacancy.nextActionAt|date('c') }}">{{ vacancy.nextActionAt|date('d M Y, H:i') }}</time>{% else %}—{% endif %}</td>
                            <td><span class="vacancy-status-pill">{{ vacancy.status.label }}</span></td>
                            <td>{% include 'dashboard/_vacancy_actions.html.twig' with { vacancy: vacancy, returnUrl: returnUrl } only %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <nav aria-label="Vacancy pages" class="dashboard-vacancy-pagination">
            {% if overview.page > 1 %}<a href="{{ path('app_dashboard', query|merge({page: overview.page - 1})) }}">Previous</a>{% endif %}
            <span>Page {{ overview.page }} of {{ overview.pages }}</span>
            {% if overview.page < overview.pages %}<a href="{{ path('app_dashboard', query|merge({page: overview.page + 1})) }}">Next</a>{% endif %}
        </nav>
    {% endif %}
</section>
