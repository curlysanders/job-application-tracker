{% extends 'base.html.twig' %}

{% block title %}Dashboard · Job Application Tracker{% endblock %}
{% block page_heading %}Dashboard{% endblock %}
{% block page_actions %}<a class="button" href="{{ path('app_vacancy_create') }}">Add vacancy</a>{% endblock %}

{% block content %}
    {% if reminders is not empty %}
        <section class="dashboard-reminders panel" aria-labelledby="dashboard-reminders-heading">
            <h2 id="dashboard-reminders-heading">Due today or overdue</h2>
            <ul>
                {% for reminder in reminders %}
                    <li>
                        <a href="{{ path('app_vacancy_show', {id: reminder.id}) }}">{{ reminder.title }}</a>
                        <span>{{ reminder.nextActionTitle ?? 'Next action' }} · <time datetime="{{ reminder.nextActionAt|date('c') }}">{{ reminder.nextActionAt|date('d M Y, H:i') }}</time></span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
    <section
        class="dashboard-pipeline"
        data-controller="vacancy-pipeline"
        data-vacancy-pipeline-url-value="{{ path('app_dashboard_pipeline_vacancies') }}"
    >
        <twig:VacancyChevronPipeline :counts="pipeline.counts" :statuses="pipelineStatuses" :selectedStatus="selectedStatus ? selectedStatus.value : null" :query="query" />
        <div class="dashboard-vacancy-results" data-vacancy-pipeline-target="results" aria-live="polite">
            {% include 'dashboard/_vacancies.html.twig' with { overview: overview, filter: filter, query: query } only %}
        </div>
    </section>
{% endblock %}
