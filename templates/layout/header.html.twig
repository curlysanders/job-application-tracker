<header class="app-header">
    <a class="app-brand" href="{{ path('app_dashboard') }}">Job Application Tracker</a>
    <div class="header-actions">
        <button type="button" class="icon-button" data-controller="theme" data-action="theme#toggle" aria-label="Toggle colour theme" title="Toggle colour theme">
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </button>
        <a class="header-profile" href="{{ path('app_profile') }}">Profile</a>
        <form action="{{ path('app_logout') }}" method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="button button-quiet">Sign out</button>
        </form>
        <button type="button" class="icon-button md:hidden" data-collapse-toggle="app-sidebar" aria-controls="app-sidebar" aria-expanded="false">
            <span>Menu</span>
        </button>
    </div>
</header>
