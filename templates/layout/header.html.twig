<header class="app-header">
    <a class="app-brand" href="{{ path('app_home') }}">Job Application Tracker</a>
    <div class="header-actions">
        {% if app.user %}
            <a class="button button-secondary" href="{{ path('app_dashboard') }}">Dashboard</a>
            <form action="{{ path('app_logout') }}" method="post">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="button button-secondary">Sign out</button>
            </form>
        {% else %}
            <a class="button button-secondary" href="{{ path('app_login') }}">Sign in</a>
            <a class="button" href="{{ path('app_register') }}">Register</a>
        {% endif %}
        <button type="button" class="button button-secondary md:hidden" data-collapse-toggle="app-sidebar" aria-controls="app-sidebar" aria-expanded="false">
            <span>Menu</span>
        </button>
    </div>
</header>
