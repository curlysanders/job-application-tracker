<header class="auth-header">
    <a class="app-brand" href="{{ path('app_dashboard') }}">Job Application Tracker</a>
    <nav aria-label="Account navigation">
        <button type="button" class="icon-button" data-controller="theme" data-action="theme#toggle" aria-label="Toggle colour theme" title="Toggle colour theme"><svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg><svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></button>
        {% if app.request.attributes.get('_route') == 'app_login' %}
            <a class="button button-quiet" href="{{ path('app_register') }}">Create account</a>
        {% elseif app.request.attributes.get('_route') == 'app_register' %}
            <a class="button button-quiet" href="{{ path('app_login') }}">Sign in</a>
        {% else %}
            <a class="button button-quiet" href="{{ path('app_login') }}">Sign in</a>
            <a class="button button-quiet" href="{{ path('app_register') }}">Create account</a>
        {% endif %}
    </nav>
</header>
