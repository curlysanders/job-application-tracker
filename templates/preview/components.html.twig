{% extends 'base.html.twig' %}
{% block title %}Component preview · Job Application Tracker{% endblock %}
{% block page_heading %}Component preview{% endblock %}
{% block content %}
    <section class="panel" aria-labelledby="interaction-heading">
        <h2 id="interaction-heading">Interactive components</h2>
        <p>Check the dropdown, modal, notifications, and mobile navigation.</p>
        <div class="preview-actions">
            <button data-controller="dropdown-accessibility" id="preview-dropdown-button" data-dropdown-toggle="preview-dropdown" class="button" type="button" aria-controls="preview-dropdown" aria-expanded="false">Open dropdown</button>
            <div id="preview-dropdown" class="hidden dropdown-panel">
                <ul aria-labelledby="preview-dropdown-button">
                    <li><a href="{{ path('app_home') }}">Home</a></li>
                    <li><button type="button" data-modal-target="preview-modal" data-modal-toggle="preview-modal">Open modal</button></li>
                </ul>
            </div>
            <button data-modal-target="preview-modal" data-modal-toggle="preview-modal" class="button button-secondary" type="button">Open modal</button>
        </div>
    </section>
    <div data-controller="modal-focus" id="preview-modal" tabindex="-1" aria-hidden="true" aria-labelledby="preview-modal-title" class="hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full h-full preview-modal">
        <div class="modal-panel">
            <h2 id="preview-modal-title">Modal preview</h2>
            <p>This dialog demonstrates the shared Flowbite styling and interaction.</p>
            <button data-modal-hide="preview-modal" type="button" class="button">Close modal</button>
        </div>
    </div>
{% endblock %}
