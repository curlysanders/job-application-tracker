{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }} · Job Application Tracker{% endblock %}
{% block page_heading %}{{ pageTitle }}{% endblock %}

{% block content %}
    <section class="panel vacancy-form-panel">
        {{ form_start(form, {attr: {'data-controller': 'vacancy-authoring', 'data-vacancy-authoring-minimum-preferred-salary-value': minimumPreferredSalary ?? '', 'data-vacancy-authoring-minimum-preferred-salary-currency-value': minimumPreferredSalaryCurrency ?? 'EUR', 'data-vacancy-authoring-rates-value': exchangeRates|json_encode}}) }}
        <fieldset>
            <legend>Role and employer</legend>
            {{ form_row(form.title) }}
            {{ form_row(form.companyId) }}
            {{ form_row(form.recruiterId) }}
            {{ form_row(form.location) }}
            {{ form_row(form.applicationSource) }}
            <div data-controller="source-url-collection">
                <div data-source-url-collection-target="list">
                    {% for sourceUrl in form.sourceUrls %}
                        <div class="source-url-row" data-source-url-collection-row>{{ form_row(sourceUrl) }}
                            <button class="button button-secondary" data-action="source-url-collection#remove"
                                    type="button">Remove URL
                            </button>
                        </div>
                    {% endfor %}
                </div>
                <template data-source-url-collection-target="template">
                    <div class="source-url-row"
                         data-source-url-collection-row>{{ form_row(form.sourceUrls.vars.prototype) }}
                        <button class="button button-secondary" data-action="source-url-collection#remove"
                                type="button">Remove URL
                        </button>
                    </div>
                </template>
                <button class="button button-secondary" data-action="source-url-collection#add" type="button">Add source
                    URL
                </button>
            </div>
            {% do form.sourceUrls.setRendered() %}

            {{ form_row(form.howToApply) }}
            {{ form_row(form.contractType) }}
            <div
                class="vacancy-date-grid">{{ form_row(form.datePosted) }}{{ form_row(form.deadline) }}{{ form_row(form.dateApplied) }}</div>
        </fieldset>

        <fieldset>
            <legend>Summary text</legend>
            {{ form_row(form.fullText) }}{{ form_row(form.requirements) }}{{ form_row(form.responsibilities) }}
            {{ form_row(form.preferredQualifications) }}{{ form_row(form.aboutJob) }}{{ form_row(form.aboutCompany) }}{{ form_row(form.compensationBenefits) }}
        </fieldset>

        <fieldset>
            <legend>Compensation and work mode</legend>
            <div
                class="vacancy-salary-grid">{{ form_row(form.minimumSalary) }}{{ form_row(form.maximumSalary) }}{{ form_row(form.currencyCode) }}</div>
            <p class="salary-guidance" data-vacancy-authoring-target="salaryGuidance" hidden aria-live="polite"></p>
            {{ form_row(form.workMode) }}
            <div data-vacancy-authoring-target="hybridDetailsContainer">{{ form_row(form.hybridDetails) }}</div>
        </fieldset>

        <fieldset data-controller="tech-stack-collection">
            <legend>Technology and excitement</legend>
            {{ form_row(form.techStacks.existingTags) }}
            <fieldset>
                <legend>New technologies</legend>
                <div data-tech-stack-collection-target="list">
                    {% for tag in form.techStacks.newTags %}
                        <div class="tech-stack-row"
                             data-tech-stack-collection-row>{{ form_row(tag.name) }}{{ form_row(tag.category) }}
                        <button class="button button-secondary" data-action="tech-stack-collection#remove"
                                type="button">Remove technology
                        </button></div>{% endfor %}
                </div>
                <template data-tech-stack-collection-target="template">
                    <div class="tech-stack-row"
                         data-tech-stack-collection-row>{{ form_row(form.techStacks.newTags.vars.prototype.name) }}{{ form_row(form.techStacks.newTags.vars.prototype.category) }}
                        <button class="button button-secondary" data-action="tech-stack-collection#remove"
                                type="button">Remove technology
                        </button>
                    </div>
                </template>
                <button class="button button-secondary" data-action="tech-stack-collection#add" type="button">Add
                    technology
                </button>
            </fieldset>
            {% do form.techStacks.setRendered() %}

            <fieldset class="star-rating">
                <legend>{{ form.excitement.vars.label }}</legend>{% for rating in form.excitement %}
                <span>{{ form_widget(rating) }}{{ form_label(rating, rating.vars.label ~ ' stars') }}</span>{% endfor %}
            </fieldset>
        </fieldset>
        {{ form_rest(form) }}
        <button class="button" type="submit">{{ submitLabel }}</button>
        {{ form_end(form, {render_rest: false}) }}
    </section>
    {% if vacancy is defined %}
        <div data-controller="vacancy-status-transition">
            <section class="panel vacancy-status-panel" aria-labelledby="vacancy-status-heading">
                <h2 id="vacancy-status-heading">Vacancy status</h2>
                <p>Current status: <strong>{{ vacancy.status.value|replace({'_': ' '})|title }}</strong></p>
                {% if enabledStatusTransitions is empty %}
                    <p>This vacancy has reached a final status.</p>
                {% else %}
                    <div class="vacancy-status-actions">
                        {% for transition in enabledStatusTransitions %}
                            <form action="{{ path('app_vacancy_transition_status', {id: vacancy.id}) }}" method="post" data-action="submit->vacancy-status-transition#open" data-transition-label="{{ transition.name|replace({'_': ' '})|title }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('vacancy_status_transition_' ~ vacancy.id) }}">
                                <input type="hidden" name="transition" value="{{ transition.name }}">
                                <button class="button button-secondary" type="submit">{{ transition.name|replace({'_': ' '})|title }}</button>
                            </form>
                        {% endfor %}
                    </div>
                    <button class="hidden" type="button" data-vacancy-status-transition-target="modalOpener" data-modal-target="vacancy-status-note-modal" data-modal-toggle="vacancy-status-note-modal">Add transition note</button>
                {% endif %}
            </section>
            {% if enabledStatusTransitions is not empty %}
                <div data-controller="modal-focus" id="vacancy-status-note-modal" tabindex="-1" aria-hidden="true" aria-labelledby="vacancy-status-note-modal-title" class="hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full h-full preview-modal">
                    <div class="modal-panel">
                        <h2 id="vacancy-status-note-modal-title">Change vacancy status</h2>
                        <p data-vacancy-status-transition-target="description"></p>
                        <form action="{{ path('app_vacancy_transition_status', {id: vacancy.id}) }}" method="post">
                            <input data-vacancy-status-transition-target="token" type="hidden" name="_token" value="">
                            <input data-vacancy-status-transition-target="transition" type="hidden" name="transition" value="">
                            <label for="vacancy-status-transition-note">Note <span class="form-help">(optional)</span></label>
                            <textarea data-vacancy-status-transition-target="note" id="vacancy-status-transition-note" name="note" rows="4" placeholder="For example, first screening scheduled"></textarea>
                            <div class="vacancy-status-actions">
                                <button data-modal-hide="vacancy-status-note-modal" type="button" class="button button-secondary">Cancel</button>
                                <button type="submit" class="button">Change status</button>
                            </div>
                        </form>
                    </div>
                </div>
            {% endif %}
            <section class="panel vacancy-status-history-panel" aria-labelledby="vacancy-status-history-heading">
                <h2 id="vacancy-status-history-heading">Status history</h2>
                {% if statusHistory is empty %}
                    <p>No status changes have been recorded yet.</p>
                {% else %}
                    <ol class="vacancy-status-history">
                        {% for history in statusHistory %}
                            <li>
                                <p><strong>{{ history.fromStatus.value|replace({'_': ' '})|title }} → {{ history.toStatus.value|replace({'_': ' '})|title }}</strong></p>
                                <time datetime="{{ history.transitionedAt|date('c') }}">{{ history.transitionedAt|date('d M Y, H:i') }}</time>
                                {% if history.notes is not null %}<p>{{ history.notes }}</p>{% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}
            </section>
        </div>
    {% endif %}
{% endblock %}
