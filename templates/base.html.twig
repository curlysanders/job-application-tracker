<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Job Application Tracker{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block body %}
            <a class="skip-link" href="#main-content">Skip to content</a>
            {% include 'layout/header.html.twig' %}
            <div class="app-shell">
                <aside id="app-sidebar" class="app-sidebar hidden md:block" aria-label="Sidebar">
                    {% block sidebar %}
                        <nav aria-label="Main navigation">
                                <a href="{{ path('app_home') }}" class="nav-link"{% if app.request.attributes.get('_route') == 'app_home' %} aria-current="page"{% endif %}>Home</a>
                                {% if app.user %}
                                    <a href="{{ path('app_company_list') }}" class="nav-link"{% if app.request.attributes.get('_route') starts with 'app_company_' %} aria-current="page"{% endif %}>Companies</a>
                                    <a href="{{ path('app_recruiter_list') }}" class="nav-link"{% if app.request.attributes.get('_route') starts with 'app_recruiter_' %} aria-current="page"{% endif %}>Recruiters</a>
                                {% endif %}
                            {% if app.environment in ['dev', 'test'] %}
                                <a href="{{ path('app_component_preview') }}" class="nav-link"{% if app.request.attributes.get('_route') == 'app_component_preview' %} aria-current="page"{% endif %}>Component preview</a>
                            {% endif %}
                        </nav>
                    {% endblock %}
                </aside>
                <main id="main-content" class="app-content" tabindex="-1">
                    {% include 'layout/flashes.html.twig' %}
                    <h1 class="page-heading">{% block page_heading %}Job Application Tracker{% endblock %}</h1>
                    {% block content %}{% endblock %}
                </main>
            </div>
        {% endblock %}
    </body>
</html>
