{% extends 'base.html.twig' %}

{% block title %}Profile settings · Job Application Tracker{% endblock %}
{% block page_heading %}Profile settings{% endblock %}

{% block content %}
    <section class="panel form-panel" aria-labelledby="profile-settings-heading">
        <h2 id="profile-settings-heading">Salary and commute preferences</h2>
        <p class="form-help">Salary is gross per month. Commute time is one way.</p>
        {{ form_start(profileForm) }}
            {{ form_row(profileForm.minimumPreferredSalary) }}
            {{ form_row(profileForm.minimumPreferredSalaryCurrency) }}
            {{ form_row(profileForm.maximumCommuteMinutes) }}
            {{ form_row(profileForm.preferredTransportMode) }}
            <button class="button" type="submit">Save settings</button>
        {{ form_end(profileForm) }}
    </section>

    <section class="panel form-panel" aria-labelledby="resume-upload-heading">
        <h2 id="resume-upload-heading">Active resume</h2>
        {% if user.resumeOriginalFilename %}
            <p class="form-help">
                Active file: <a href="{{ path('app_profile_resume') }}">{{ user.resumeOriginalFilename }}</a>
                {% if user.resumeUploadedAt %} (uploaded {{ user.resumeUploadedAt|date('j M Y, H:i') }}){% endif %}
            </p>
            <p class="form-help">A new upload replaces this file after its background validation succeeds.</p>
        {% else %}
            <p class="form-help">No active resume has been uploaded.</p>
        {% endif %}
        {% if user.resumeValidationStatus is not null %}
            <p class="form-help" role="status">
                {% if user.resumeValidationStatus.value == 'pending' %}
                    Your uploaded resume is being checked. Your current active file remains available.
                {% elseif user.resumeValidationStatus.value == 'validated' %}
                    Your active resume has been validated.
                {% else %}
                    Resume validation failed{% if user.resumeValidationFailure %}: {{ user.resumeValidationFailure }}{% endif %}. Your current active file remains available.
                {% endif %}
            </p>
        {% endif %}
        {{ form_start(resumeForm) }}
            {{ form_row(resumeForm.resume) }}
            <button class="button" type="submit">Upload resume</button>
        {{ form_end(resumeForm) }}
    </section>
{% endblock %}
