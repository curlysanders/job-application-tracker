{% extends 'base.html.twig' %}

{% block title %}Companies · Job Application Tracker{% endblock %}
{% block page_heading %}Companies{% endblock %}

{% block content %}
    <section class="panel management-list">
        <div class="management-actions">
            <form method="get" role="search">
                <label for="company-search">Search companies</label>
                <input id="company-search" name="q" value="{{ query }}" placeholder="Name, industry, or contact">
                <button class="button" type="submit">Search</button>
            </form>
            <a class="button" href="{{ path('app_company_create') }}">Add company</a>
        </div>
        {% if companies is empty %}<p>No companies found.</p>{% else %}
            <ul class="management-results">
                {% for company in companies %}
                    <li><div><strong>{{ company.name }}</strong>{% if company.industry %}<span>{{ company.industry }}</span>{% endif %}{% if company.directContacts is not empty %}<span>{{ company.directContacts|length }} contact{{ company.directContacts|length == 1 ? '' : 's' }}</span>{% endif %}</div><a class="button button-secondary" href="{{ path('app_company_edit', {id: company.id}) }}">Edit</a></li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endblock %}
