APP_SECRET=change-me

DEFAULT_URI=https://localhost

# Local AI is deliberately disabled by default.
AI_PROVIDER=fake
AI_LOCAL_PROVIDER_ENABLED=0
AI_GLINER_PROVIDER_ENABLED=0
OLLAMA_HOST_URL=http://ollama:11434
# A full CPU corpus run has a deliberately generous per-case limit. Production
# admission still requires measured NAS latency evidence.
AI_LOCAL_TIMEOUT_SECONDS=300
AI_LOCAL_MODEL=granite4.2:3b
GLINER_URL=http://gliner:8080
AI_GLINER_TIMEOUT_SECONDS=300
AI_ANALYSIS_ENCRYPTION_KEY=
