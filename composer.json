{
    "name": "curlysanders/job-application-tracker",
    "description": "A self-hosted application for tracking job applications.",
    "license": "AGPL-3.0-only",
    "type": "project",
    "homepage": "https://github.com/curlysanders/job-application-tracker",
    "support": {
        "issues": "https://github.com/curlysanders/job-application-tracker/issues"
    },
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-bcmath": "*",
        "ext-iconv": "*",
        "brick/money": "^0.15.2",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7.5",
        "league/commonmark": "^2.7",
        "league/flysystem-bundle": "^3.7",
        "lingoda/domain-events": "^3.0",
        "nelmio/security-bundle": "^3.9",
        "symfony/ai-bundle": "^0.14.1",
        "symfony/ai-ollama-platform": "^0.14.0",
        "symfony/ai-platform": "^0.14.1",
        "symfony/asset": "~8.1.0",
        "symfony/asset-mapper": "~8.1.9",
        "symfony/cache": "~8.1.9",
        "symfony/console": "~8.1.9",
        "symfony/dotenv": "~8.1.0",
        "symfony/flex": "^2",
        "symfony/form": "~8.1.9",
        "symfony/framework-bundle": "~8.1.9",
        "symfony/http-client": "~8.1.9",
        "symfony/messenger": "~8.1.9",
        "symfony/mime": "~8.1.7",
        "symfony/monolog-bundle": "^4.1",
        "symfony/rate-limiter": "~8.1.0",
        "symfony/runtime": "~8.1.9",
        "symfony/security-bundle": "~8.1.9",
        "symfony/stimulus-bundle": "^3.6.0",
        "symfony/twig-bundle": "~8.1.9",
        "symfony/uid": "~8.1.9",
        "symfony/ux-autocomplete": "^3.6",
        "symfony/ux-twig-component": "^3.6.0",
        "symfony/validator": "~8.1.9",
        "symfony/workflow": "~8.1.8",
        "symfony/yaml": "~8.1.9"
    },
    "require-dev": {
        "brianium/paratest": "^7.27.1",
        "dama/doctrine-test-bundle": "^8.7",
        "deptrac/deptrac": "^4.7.2",
        "ergebnis/composer-normalize": "^2.54",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4.2",
        "rector/rector": "^2.7.0",
        "spaze/phpstan-disallowed-calls": "^4.15",
        "symfony/browser-kit": "~8.1.9",
        "symfony/css-selector": "~8.1.0",
        "symfony/debug-bundle": "~8.1.0",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "~8.1.0",
        "symfony/web-profiler-bundle": "~8.1.9",
        "symplify/config-transformer": "^12.5"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "CurlySanders\\JobApplicationTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CurlySanders\\JobApplicationTracker\\Tests\\": "tests/",
            "CurlySanders\\JobApplicationTracker\\PhpCsFixer\\": "tools/PhpCsFixer/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php scripts/composer/patch-paratest.php",
            "@auto-scripts",
            "@php scripts/composer/remove-csp-incompatible-importmap-css.php"
        ],
        "post-update-cmd": [
            "@php scripts/composer/patch-paratest.php",
            "@auto-scripts",
            "@php scripts/composer/remove-csp-incompatible-importmap-css.php"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse",
            "@php vendor/bin/deptrac analyse --fail-on-uncovered"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "ci:coverage": [
            "@php vendor/bin/paratest --coverage-cobertura=var/coverage/cobertura.xml --coverage-text"
        ],
        "ci:doctrine-schema": [
            "@php bin/console doctrine:schema:validate --skip-sync --env=test",
            "@php bin/console app:doctrine:schema:assert-synchronized --env=test"
        ],
        "ci:deptrac": [
            "@php vendor/bin/deptrac analyse --fail-on-uncovered"
        ],
        "ci:php-cs-fixer": [
            "@php vendor/bin/php-cs-fixer fix --dry-run --diff"
        ],
        "ci:phpstan": [
            "@php vendor/bin/phpstan analyse"
        ],
        "ci:phpunit": [
            "@php vendor/bin/paratest"
        ],
        "fix": [
            "@php vendor/bin/rector process",
            "@php vendor/bin/php-cs-fixer fix"
        ],
        "tests": [
            "@php vendor/bin/paratest"
        ]
    }
}
